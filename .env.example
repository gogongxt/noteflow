# Copy to .env.deploy and fill in. Used by scripts/deploy.sh.
DEPLOY_HOST=deploy@example.com
DEPLOY_ROOT=/srv/noteflow

# Optional: remote path of the nginx security-headers snippet (regenerated
# from the build manifest on every deploy, because CSP hashes change per build).
# The deploy user needs write access to it (pre-authorized sudo if needed).
# DEPLOY_NGINX_SNIPPET=/etc/nginx/snippets/noteflow-security-headers.conf

# Optional: remote path of the rate-limit zones snippet (http{} context).
# Defaults to a sibling file of the header snippet.
# DEPLOY_NGINX_ZONES_SNIPPET=/etc/nginx/snippets/noteflow-rate-limit-zones.conf
